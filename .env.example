# Base URL of the backend API. Never hardcode this in a component.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_TIMEOUT=30000

# Must match the backend's MAX_FILE_SIZE_BYTES
VITE_MAX_FILE_SIZE_BYTES=10485760

# Canadian localization defaults - see src/utils/locale.js. A signed-in
# user's own timezone/locale (from the API) overrides these; they only apply
# before login and as the fallback for users without a preference set.
VITE_DEFAULT_LOCALE=en-CA
VITE_DEFAULT_TIMEZONE=America/Toronto
VITE_DEFAULT_CURRENCY=CAD
VITE_DEFAULT_COUNTRY=CA
